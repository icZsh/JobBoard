# Copy to .env; use a long random URL-safe password (letters/digits/-/_).
# This is deployment configuration only. Set job preferences in the web setup.
POSTGRES_PASSWORD=replace-with-a-long-random-password
JOBBOARD_PORT=3010
COMPOSE_PROJECT_NAME=jobboard-selfhost

# Optional: resume tailoring only. Collection/scoring/tracking work without it.
GEMINI_API_KEY=
GEMINI_RESUME_MODEL=gemini-3.1-pro-preview
